Properties Collection Structure
javascript{
  // === COMMON FIELDS (All Property Types) ===
  
  // Identification & Ownership
  userId: string,              // Firebase UID of the property owner
  brokerId: string,            // Firebase UID (for broker listings)
  ownerId: string,             // Firebase UID (for landlord listings)
  userType: "broker" | "landlord",
  
  // Property Basic Info
  title: string,               // Property title/name
  propertyCategory: string,    // "residential", "commercial", "industrial", "land", "condo", "special"
  propertyType: string,        // Specific type based on category
  description: string,         // Detailed property description
  
  // Listing Info
  type: "rent" | "lease" | "sale",
  status: "available" | "rented" | "leased" | "sold" | "pending",
  listingType: "rent" | "lease" | "sale",  // Redundant with 'type'
  
  // Location
  address: string,             // Full address
  location: string,            // Same as address (redundant)
  city: string,                // City/Municipality
  province: string,            // Province
  latitude: number,            // Geographic coordinates
  longitude: number,
  
  // Images
  imageUrls: array,            // Array of image URLs
  photos: array,               // Same as imageUrls (redundant)
  
  // Timestamps
  createdAt: timestamp,        // When property was created
  updatedAt: timestamp,        // Last update time
  
  // === RENT-SPECIFIC FIELDS ===
  bedrooms: string,            // "studio", "1", "2", "3", "4", "5+"
  bathrooms: string,           // "1", "2", "3", "4+"
  floorArea: number,           // Square meters
  furnishing: string | null,   // "furnished", "semi-furnished", "unfurnished"
  monthlyRent: number,         // Monthly rental price in PHP
  securityDeposit: number | null,  // Security deposit amount
  advanceRent: number,         // Number of months advance (default: 1)
  minimumStay: number,         // Minimum rental period in months
  amenities: array,            // Array of amenity strings
  
  // === LEASE-SPECIFIC FIELDS ===
  totalArea: number,           // Total area in sqm
  usableArea: number | null,   // Usable area in sqm
  zoning: string | null,       // "commercial", "industrial", "residential", "agricultural", "mixed_use", "tourism"
  leaseType: string,           // "gross", "net", "triple-net"
  leaseDuration: number,       // Duration in years
  renewalOption: string | null, // "automatic", "negotiable", "none"
  annualRent: number,          // Annual rent in PHP
  paymentTerms: string | null, // "monthly", "quarterly", "semi-annual", "annual"
  securityBond: number | null, // Security bond amount
  advancePayment: number,      // Advance payment in months (default: 1)
  frontage: number | null,     // Frontage in meters
  topography: string | null,   // "flat", "sloping", "hilly", "mountainous"
  accessRoad: string | null,   // "concrete", "asphalt", "gravel", "dirt"
  restrictions: string | null, // Use restrictions description
  maintenance: string | null,  // "landlord", "tenant", "shared"
  
  // === SALE-SPECIFIC FIELDS ===
  bedrooms: string,            // "studio", "1", "2", "3", "4", "5+"
  bathrooms: string,           // "1", "2", "3", "4+"
  floorArea: number,           // Floor area in sqm
  lotArea: number | null,      // Lot area in sqm
  furnishing: string | null,   // "furnished", "semi-furnished", "unfurnished"
  yearBuilt: number | null,    // Year property was built
  salePrice: number,           // Asking price in PHP
  priceNegotiable: string,     // "yes" | "no"
  saleType: string,            // "outright_sale", "installment", "bank_financing"
  commissionType: string,      // "percentage" | "fixed"
  commissionValue: number,     // Commission value (% or fixed amount)
}
